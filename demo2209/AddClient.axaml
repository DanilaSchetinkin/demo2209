<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="300" d:DesignHeight="450"
        x:Class="demo2209.AddClient"
        Title="AddClient">
	<Grid ShowGridLines="True" RowDefinitions="*,*,*,*,*,40">
			<TextBox x:Name="CodeBox" Grid.Row="0" Width="200" Height="30" Watermark="Код клиента" ></TextBox>
			<TextBox x:Name="emailBox" Grid.Row="1" Width="200" Height="30" VerticalAlignment="Top" Watermark="e-mail" ></TextBox>
			<TextBox x:Name="FioBox" Grid.Row="1" Width="200" Height="30" VerticalAlignment="Bottom" Watermark="Фио" ></TextBox>
		<TextBox x:Name="adresBox" Grid.Row="2" Width="200" Height="30" Watermark="адрес" ></TextBox>
		<TextBox x:Name="passportBox" Grid.Row="3" Width="200" Height="30" VerticalAlignment="Top" Watermark="паспорт" ></TextBox>
		<TextBox x:Name="passwordBox" Grid.Row="3" Width="200" Height="30" VerticalAlignment="Bottom" Watermark="пароль" ></TextBox>
		<TextBox x:Name="BirthDayBox" Grid.Row="4" Width="200" Height="30" Watermark="Дата рождения гггг-мм-дд" ></TextBox>
		<Button Grid.Row="5" Content="Добавить клиента" HorizontalAlignment="Center" Click="Add_Client" >
			
		</Button>
	</Grid>
	
</Window>
