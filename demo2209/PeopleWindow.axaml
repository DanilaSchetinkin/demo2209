<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="demo2209.PeopleWindow"
        x:CompileBindings="False"
        Title="PeopleWindow">
  <Grid ShowGridLines="True">
      <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>
      <Grid.RowDefinitions>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="*"/>
      </Grid.RowDefinitions>
      
      
      <StackPanel Grid.Column="0" Grid.Row="1" Grid.ColumnSpan="3" HorizontalAlignment="Right" VerticalAlignment="Top">
          <TextBlock x:Name="SessionTimerText" VerticalAlignment="Bottom" Text="Время сеанса: 10:00" FontWeight="Bold" Foreground="Green"/>
          <TextBlock x:Name="WarningText" Text="" Foreground="Red" FontWeight="Bold" IsVisible="False"/>
      </StackPanel>
     
      <StackPanel Grid.Column="2" Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center">
          <Image x:Name="imageBox" Width="75" Height="100"/>
          <TextBlock x:Name="fioBox" />
          <TextBlock x:Name="roleBox" />
          <Button x:Name="LogoutButton" Click="LogoutButton_Click" Content="Выйти"></Button>
      </StackPanel>
      

      <!-- Админ -->
      <StackPanel Grid.Column="0" Grid.Row="0" x:Name="AdminPanel">
          <StackPanel Height="20"></StackPanel>
          <TextBlock Text="История входов" HorizontalAlignment="Center" VerticalAlignment="Top"/>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Height="600" >
          <ListBox x:Name="EnterBox">
              <ListBox.ItemTemplate>
                  <DataTemplate>
                      <Border BorderBrush="Gray" BorderThickness="0,0,0,1" >
                          <StackPanel>
                              <TextBlock Text="{Binding Time}"/>
                              <TextBlock Text="{Binding UserLogin}"/>
                              <TextBlock Text="{Binding LoginType}"/>
                          </StackPanel>
                      </Border>
                  </DataTemplate>
              </ListBox.ItemTemplate>
          </ListBox>
              </ScrollViewer>
      </StackPanel>

      <StackPanel Grid.Column="1" Grid.Row="0" Grid.RowSpan="1" x:Name="FilterAdmin">
          <StackPanel Height="20"></StackPanel>
          <TextBlock Text="Фильтры" HorizontalAlignment="Center"></TextBlock>
      </StackPanel>
      
     <StackPanel Grid.Column="1" Grid.Row="1" x:Name="ComboAdmin">
         <TextBlock Text="Сортировки: " Grid.Column="1" VerticalAlignment="Bottom" Grid.Row="0"></TextBlock>
         <StackPanel>
             <TextBlock Text="Логин"></TextBlock>
             <TextBlock Text="По дате"></TextBlock>
         </StackPanel>
         <ComboBox x:Name="LoginComboBox">
             <ComboBoxItem>По увелечению</ComboBoxItem>
             <ComboBoxItem>По уменьшению</ComboBoxItem>
             <ComboBoxItem>По умолчанию</ComboBoxItem>
         </ComboBox>
         <ComboBox x:Name="DateComboBox">
             <ComboBoxItem>По увелечению</ComboBoxItem>
             <ComboBoxItem>По уменьшению</ComboBoxItem>
             <ComboBoxItem>По умолчанию</ComboBoxItem>
         </ComboBox>
     </StackPanel>

      <!-- Продавец -->
      <StackPanel x:Name="CustomerPanel" Grid.Column="0" Grid.Row="0" >
          <StackPanel Height="25"></StackPanel>
      <Button  HorizontalAlignment="Center" x:Name="CreateOrder" Click="CreateOrder_Click" Content="Создать заказ"></Button>
</StackPanel>
  </Grid>
</Window>